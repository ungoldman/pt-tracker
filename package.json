{
  "name": "pt-tracker",
  "description": "A small Vite + React app for tracking daily physical therapy exercises.",
  "version": "1.0.0",
  "author": "Nate Goldman",
  "bin": {
    "pt": "./bin/pt.js"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.24",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.3"
  },
  "homepage": "https://ungoldman.github.io/pt-tracker/",
  "license": "ISC",
